# --- Database ---
POSTGRES_USER=climascore
POSTGRES_PASSWORD=climascore
POSTGRES_DB=climascore
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://climascore:climascore@db:5432/climascore

# --- Rate limiting ---
# Optional. If unset, slowapi falls back to an in-memory limiter (fine for a single-instance demo).
REDIS_URL=

# --- API ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Optional live integrations (never required for the demo) ---
# Leaving these unset degrades gracefully to seeded/static data per spec section 22.
NEXT_PUBLIC_MAPBOX_TOKEN=
OPENWEATHER_API_KEY=
